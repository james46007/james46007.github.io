---
import { content, profile, type Locale } from "../i18n/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale].about;
---

<section id="about" class="mx-auto max-w-[1440px] px-4 pt-[clamp(64px,8vw,120px)] sm:px-[clamp(16px,4vw,56px)]">
  <div class="grid items-start gap-x-16 gap-y-10 lg:grid-cols-[minmax(280px,420px)_1fr]">
    <div class="relative aspect-[4/5] w-full max-w-[420px] border-[1.5px] border-rule bg-accent" data-reveal>
      {profile.photo ? (
        <img src={profile.photo} alt={t.photoAlt} class="size-full object-cover" width="420" height="525" loading="lazy" />
      ) : (
        <span class="grid size-full place-items-center font-display text-[clamp(120px,14vw,200px)] leading-none text-on-accent" aria-hidden="true">JY</span>
      )}
      <span class="label absolute -bottom-[1.5px] -left-[1.5px] bg-ink px-3 py-2 text-paper">{t.location}</span>
    </div>

    <div data-reveal>
      <h2 class="label text-muted">(03) {t.eyebrow}</h2>
      <blockquote class="mt-[18px] font-serif text-[clamp(34px,3.6vw,54px)] leading-[1.05]">“{t.quote}”</blockquote>
      {t.body.map((p) => <p class="mt-6 max-w-[640px] text-lg leading-[1.6] text-soft">{p}</p>)}

      <div class="mt-10 grid gap-x-10 gap-y-7 border-t-[1.5px] border-rule pt-6 sm:grid-cols-2 xl:grid-cols-3">
        <div>
          <h3 class="label font-medium text-muted">{t.educationTitle}</h3>
          {t.education.map((e) => (
            <div class="mt-3">
              <p class="font-semibold">{e.degree}</p>
              <p class="text-[15px] text-muted">{e.school} · {e.period}</p>
            </div>
          ))}
        </div>
        <div>
          <h3 class="label font-medium text-muted">{t.certsTitle}</h3>
          {t.certs.map((c) => <p class="mt-3 font-semibold">{c}</p>)}
        </div>
        <div>
          <h3 class="label font-medium text-muted">{t.skillsTitle}</h3>
          <dl>
            {Object.entries(t.skills).map(([group, items]) => (
              <div class="mt-3">
                <dt class="font-semibold">{group}</dt>
                <dd class="text-[15px] leading-relaxed text-muted">{items.join(" · ")}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
