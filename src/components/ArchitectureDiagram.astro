---
import { content, type Locale } from "../i18n/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = content[locale].diagram;

const W = 150;
const H = 64;
type Node = { id: string; x: number; y: number; w?: number; label: string; note?: string; strong?: boolean };
const nodes: Node[] = [
  { id: "player", x: 20, y: 170, w: 110, label: d.player },
  { id: "whatsapp", x: 180, y: 60, label: d.whatsapp },
  { id: "web", x: 180, y: 260, label: d.web },
  { id: "evolution", x: 370, y: 60, label: d.evolution },
  { id: "n8n", x: 560, y: 60, label: d.n8n, note: d.n8nNote },
  { id: "api", x: 550, y: 260, w: 170, label: d.api, note: d.apiNote, strong: true },
  { id: "jobs", x: 370, y: 390, label: d.jobs, note: d.jobsNote },
  { id: "llm", x: 810, y: 130, label: d.llm, note: d.llmNote },
  { id: "db", x: 810, y: 260, label: d.db, note: d.dbNote },
  { id: "storage", x: 810, y: 390, label: d.storage, note: d.storageNote },
];

// Edges as SVG path data. "hot" edges carry the animated booking packet.
const edges = [
  { d: "M130 202 C 155 202, 155 92, 180 92", hot: true },
  { d: "M130 202 C 155 202, 155 292, 180 292" },
  { d: "M330 92 H 370", hot: true },
  { d: "M520 92 H 560", hot: true },
  { d: "M635 124 V 260", hot: true },
  { d: "M330 292 H 550" },
  { d: "M520 422 H 600 V 324" },
  { d: "M720 292 C 760 292, 760 162, 810 162", hot: true },
  { d: "M720 292 H 810", hot: true },
  { d: "M720 292 C 760 292, 760 422, 810 422" },
];

// Path the booking packet follows: WhatsApp → Evolution → n8n → API → Gemini → API → DB
const packetPath =
  "M130 202 C 155 202, 155 92, 180 92 H 330 H 370 H 520 H 560 H 635 V 124 V 260 V 292 H 720 C 760 292, 760 162, 810 162 C 760 162, 760 292, 720 292 H 810";
---

<figure class="diagram">
  <div class="-mx-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
    <svg viewBox="0 0 980 470" class="min-w-[720px] w-full" role="img" aria-labelledby="arch-title">
      <title id="arch-title">{content[locale].pita.diagramCaption}</title>
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" fill="var(--muted)" />
        </marker>
      </defs>

      {edges.map((e) => (
        <path d={e.d} class:list={["edge", e.hot && "edge-hot"]} fill="none" marker-end="url(#arrow)" />
      ))}

      {nodes.map((n) => (
        <g class:list={["node", n.strong && "node-strong"]}>
          <rect x={n.x} y={n.y} width={n.w ?? W} height={H} rx="12" />
          <text x={n.x + (n.w ?? W) / 2} y={n.y + (n.note ? 28 : 37)} text-anchor="middle" class="node-label">{n.label}</text>
          {n.note && <text x={n.x + (n.w ?? W) / 2} y={n.y + 47} text-anchor="middle" class="node-note">{n.note}</text>}
        </g>
      ))}

      <circle r="6" class="packet">
        <animateMotion dur="7s" repeatCount="indefinite" path={packetPath} keyPoints="0;1" keyTimes="0;1" calcMode="linear" />
      </circle>
    </svg>
  </div>
</figure>

<style>
  .edge {
    stroke: var(--line);
    stroke-width: 1.5;
  }
  [data-theme="dark"] .edge { stroke: #4a4741; }
  .edge-hot {
    stroke: var(--accent);
    stroke-opacity: 0.55;
    stroke-dasharray: 5 7;
    animation: flow 1.4s linear infinite;
  }
  @keyframes flow {
    to { stroke-dashoffset: -24; }
  }
  .node rect {
    fill: var(--node);
    stroke: var(--line);
    stroke-width: 1.2;
  }
  [data-theme="dark"] .node rect { stroke: #3a3833; }
  .node-strong rect {
    stroke: var(--accent);
    stroke-width: 2;
    fill: var(--accent-soft);
  }
  .node-label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink);
  }
  .node-note {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--muted);
  }
  .packet {
    fill: var(--accent);
    filter: drop-shadow(0 0 6px var(--accent));
  }
  @media (prefers-reduced-motion: reduce) {
    .packet { display: none; }
  }
</style>
