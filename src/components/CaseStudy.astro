---
import { content, profile, type Locale } from "../i18n/content";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale].pita;
const stack = ["Next.js 16", "React 19", "TypeScript", "Prisma", "PostgreSQL", "Supabase", "Gemini", "n8n", "Docker", "Evolution API"];
const links = [
  profile.pita.demo && { href: profile.pita.demo, label: t.links.demo, primary: true },
  { href: profile.pita.repo, label: t.links.repo },
  { href: profile.pita.botRepo, label: t.links.bot },
].filter(Boolean) as { href: string; label: string; primary?: boolean }[];
// Put the subtitle's "WhatsApp" phrase in the accent color.
const [subBefore, subAfter] = t.subtitle.split(/WhatsApp/);
---

<section id="work" class="ink-surface mt-[clamp(56px,8vw,112px)]">
  <div class="mx-auto max-w-[1440px] px-4 py-[clamp(56px,7vw,104px)] sm:px-[clamp(16px,4vw,56px)]">
    <div class="label flex flex-wrap justify-between gap-3 text-muted">
      <span>(01) {t.eyebrow}</span>
      <span>{t.role}</span>
    </div>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-x-12 gap-y-6" data-reveal>
      <h2 class="font-display text-[clamp(120px,22vw,320px)] leading-[0.8] text-transparent uppercase [-webkit-text-stroke:2px_var(--accent)]">{t.title}</h2>
      <p class="mb-3 max-w-[540px] font-serif text-[clamp(28px,2.8vw,40px)] leading-[1.08]">
        {subAfter !== undefined ? <>{subBefore}<em class="text-accent">WhatsApp</em>{subAfter}</> : t.subtitle}
      </p>
    </div>

    {profile.pita.video && (
      <video class="mt-12 w-full border-[1.5px] border-rule" src={profile.pita.video} autoplay muted loop playsinline />
    )}

    <div class="mt-14 grid gap-x-16 gap-y-8 md:grid-cols-2" data-reveal>
      {[t.problem, t.solution].map((b) => (
        <div>
          <h3 class="label font-medium text-accent">{b.title}</h3>
          <p class="mt-3.5 text-[19px] leading-[1.6] text-soft">{b.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-[72px] border-t-[1.5px] border-rule pt-7" data-reveal>
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="label font-medium text-muted">{t.diagramTitle}</h3>
        <p class="text-sm text-muted">{t.diagramCaption}</p>
      </div>
      <ArchitectureDiagram locale={locale} />
    </div>

    <ol class="mt-16 grid gap-x-16 md:grid-cols-2" data-reveal>
      {t.highlights.map((h, i) => (
        <li class="flex gap-5 border-t-[1.5px] border-rule py-[22px]">
          <span class="font-display text-[32px] leading-none text-accent">{String(i + 1).padStart(2, "0")}</span>
          <p class="text-[17px] leading-[1.55] text-soft">{h}</p>
        </li>
      ))}
    </ol>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-6">
      <div class="flex flex-wrap gap-3">
        {links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex min-h-[52px] items-center px-6 font-semibold",
              l.primary ? "bg-accent font-bold text-on-accent hover:opacity-85" : "border-[1.5px] border-ink hover:bg-ink hover:text-paper",
            ]}
          >
            {l.label} ↗
          </a>
        ))}
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted" aria-label="Stack">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>
