---
import { content, profile, type Locale } from "../i18n/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
---

<section id="contact" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32" data-reveal>
    <h2 class="max-w-4xl font-display text-5xl leading-[1.02] tracking-tight sm:text-7xl lg:text-8xl">{t.contact.title}</h2>
    <p class="mt-6 max-w-xl text-lg text-muted">{t.contact.body}</p>
    <a
      href={`mailto:${profile.email}`}
      class="mt-10 inline-block break-all font-display text-3xl text-accent underline decoration-1 underline-offset-8 transition-colors hover:text-ink sm:text-5xl"
    >
      {profile.email}
    </a>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink/20 px-5 py-2.5 text-sm font-medium transition-colors hover:border-ink">{t.contact.linkedin}</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink/20 px-5 py-2.5 text-sm font-medium transition-colors hover:border-ink">{t.contact.github}</a>
    </div>
  </div>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
      <p>© {new Date().getFullYear()} {profile.fullName}</p>
      <p>{t.footer.built}</p>
    </div>
  </footer>
</section>
