---
import { content, type Locale } from "../i18n/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale].experience;
const [featured, ...rest] = t.jobs;
---

<section id="experience" class="mx-auto max-w-[1440px] px-4 pt-[clamp(64px,8vw,120px)] sm:px-[clamp(16px,4vw,56px)]">
  <div class="flex flex-wrap items-baseline justify-between gap-3 border-b-[1.5px] border-rule pb-4" data-reveal>
    <h2 class="font-display text-[clamp(56px,8vw,120px)] leading-[0.9] uppercase">{t.eyebrow}</h2>
    <span class="label text-muted">(02) {t.since}</span>
  </div>

  <article class="grid gap-x-14 gap-y-4 border-b-[1.5px] border-rule py-10 md:grid-cols-2" data-reveal>
    <div>
      <p class="font-display text-[clamp(52px,6vw,88px)] leading-[0.9] uppercase">
        {featured.from}—{featured.to ?? <span class="bg-accent px-1.5 text-on-accent">{t.now}</span>}
      </p>
      <h3 class="mt-[18px] text-[26px] font-bold tracking-[-0.01em]">{featured.company}</h3>
      <p class="mt-1 text-muted">{featured.role} · {featured.place}</p>
      <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted" aria-label="Stack">
        {featured.stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <ul class="flex flex-col gap-3.5 text-[18px] leading-[1.55]">
      {featured.points.map((p) => (
        <li class="flex gap-3.5"><span aria-hidden="true" class="mt-[0.7em] h-0.5 w-3.5 flex-none bg-ink"></span>{p}</li>
      ))}
    </ul>
  </article>

  {rest.map((job) => (
    <article class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-b-[1.5px] border-rule py-7" data-reveal>
      <p class="min-w-[220px] font-display text-[40px] leading-none">{job.from}—{job.to}</p>
      <h3 class="flex-[1_1_280px] text-2xl font-bold">{job.company}</h3>
      <p class="text-muted">{job.role}</p>
    </article>
  ))}

  <article class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-b-[1.5px] border-rule py-7" data-reveal>
    <p class="min-w-[220px] font-display text-[40px] leading-none">{t.earlier.period.replace(/\s/g, "")}</p>
    <p class="flex-[1_1_480px] text-lg leading-normal text-soft">{t.earlier.text}</p>
  </article>
</section>
