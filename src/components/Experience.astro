---
import { content, type Locale } from "../i18n/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale].experience;
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  <div class="grid gap-10 lg:grid-cols-[280px_1fr] lg:gap-16">
    <div data-reveal>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{t.eyebrow}</p>
      <h2 class="mt-4 font-display text-5xl tracking-tight sm:text-6xl">{t.title}</h2>
    </div>

    <ol class="divide-y divide-line border-y border-line">
      {t.jobs.map((job) => (
        <li class="grid gap-3 py-8 sm:grid-cols-[180px_1fr] sm:gap-8" data-reveal>
          <div class="font-mono text-xs leading-relaxed text-muted">
            <p>{job.period}</p>
            <p>{job.place}</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold">{job.company}</h3>
            <p class="text-muted">{job.role}</p>
            {job.points.length > 0 && (
              <ul class="mt-4 space-y-2.5">
                {job.points.map((p) => (
                  <li class="relative pl-5 leading-relaxed before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-accent">{p}</li>
                ))}
              </ul>
            )}
            {job.stack.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {job.stack.map((s) => <li class="rounded-full bg-paper-2 px-3 py-1 font-mono text-xs text-muted">{s}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
      <li class="grid gap-3 py-8 sm:grid-cols-[180px_1fr] sm:gap-8" data-reveal>
        <p class="font-mono text-xs text-muted">{t.earlier.period}</p>
        <p class="leading-relaxed text-muted">{t.earlier.text}</p>
      </li>
    </ol>
  </div>
</section>
