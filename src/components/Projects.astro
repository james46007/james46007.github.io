---
import { content, type Locale } from "../i18n/content";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale].projects;
---

<section class="mx-auto max-w-[1440px] px-4 pt-[clamp(64px,8vw,112px)] sm:px-[clamp(16px,4vw,56px)]">
  <h2 class="label text-muted">{t.eyebrow}</h2>
  <div class="mt-5 grid border-[1.5px] border-rule md:grid-cols-2" data-reveal>
    {t.items.map((p, i) => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "group flex min-h-60 flex-col gap-4 p-8 transition-colors hover:bg-accent hover:text-on-accent",
          i > 0 && "border-t-[1.5px] border-rule md:border-t-0 md:border-l-[1.5px]",
        ]}
      >
        <span class="flex justify-between font-mono text-xs text-muted group-hover:text-on-accent">
          <span>{p.year}</span><span>{t.viewCode} ↗</span>
        </span>
        <span class="font-serif text-[clamp(36px,3.2vw,44px)] leading-none">{p.name}</span>
        <span class="text-[17px] leading-[1.55] text-soft group-hover:text-on-accent">{p.body}</span>
        <span class="mt-auto font-mono text-xs text-muted group-hover:text-on-accent">{p.stack.join(" · ")}</span>
      </a>
    ))}
  </div>
</section>
