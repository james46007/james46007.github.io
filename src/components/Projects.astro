---
import type { Locale } from "../i18n/content";
import { site } from "../i18n/site";
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = site[locale].projects;
// Full class names so Tailwind can see them.
const tones: Record<string, string> = {
  blue: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  purple: "bg-purple-500/10 text-purple-400 border-purple-500/20",
  emerald: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  amber: "bg-amber-500/10 text-amber-400 border-amber-500/20",
};
---

<section id="projects" class="mt-28 space-y-8">
  <SectionTitle eyebrow={t.eyebrow} title={t.title} />
  <div class="grid gap-6 md:grid-cols-2">
    {t.items.map((p) => (
      <article class="glass-card flex flex-col justify-between space-y-6 rounded-2xl p-6">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class:list={["rounded-md border px-2.5 py-1 font-mono text-xs", tones[p.color]]}>{p.tag}</span>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-neutral-400 transition hover:text-white" aria-label={`${t.codeLabel}: ${p.name}`}>
              <Icon name="github" />
            </a>
          </div>
          <h4 class="text-xl font-bold text-white">{p.name}</h4>
          <p class="text-sm leading-relaxed text-neutral-400">{p.body}</p>
        </div>
        <p class="border-t border-neutral-800/80 pt-2 font-mono text-xs text-neutral-400">{p.stack.join(" • ")}</p>
      </article>
    ))}
  </div>
</section>
