---
import type { Locale } from "../i18n/content";
import { site } from "../i18n/site";
import SectionTitle from "./SectionTitle.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = site[locale].skills;
---

<section id="skills" class="mt-28 space-y-8">
  <SectionTitle eyebrow={t.eyebrow} title={t.title} />
  <div class="grid gap-6 md:grid-cols-2">
    {t.groups.map((g) => (
      <div class="glass-card space-y-4 rounded-2xl p-6">
        <h4 class="text-sm font-semibold tracking-wider text-neutral-300 uppercase">{g.title}</h4>
        <ul class="flex flex-wrap gap-2">
          {g.items.map((s) => (
            <li class="rounded-lg border border-neutral-700/60 bg-neutral-800/80 px-3 py-1 text-xs font-medium text-neutral-200">{s}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
